# Anthropic — powers the validation layer and chat. Absent = deterministic-only mode.
ANTHROPIC_API_KEY=

# FantasyPros v2 — https://secure.fantasypros.com/api-keys/request/
# Absent = fall back to the nflverse mirror of FantasyPros draft rankings.
FANTASYPROS_API_KEY=

# Season to analyze. Defaults to the current NFL season.
# APOLLO_SEASON=2026

# Where cached nflverse/Sleeper/FantasyPros payloads land.
# APOLLO_CACHE_DIR=.cache

# APOLLO_DB_PATH=apollo.db
